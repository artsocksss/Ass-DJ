const GEMINI_URL =
  "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent";

export class AssDJAgent {
  private async ask(prompt: string) {
    const response = await fetch(GEMINI_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-goog-api-key": process.env.GEMINI_API_KEY || "",
      },
      body: JSON.stringify({
        contents: [
          {
            parts: [
              {
                text: prompt,
              },
            ],
          },
        ],
      }),
    });

    const data = await response.json();

    return (
      data?.candidates?.[0]?.content?.parts?.[0]?.text ||
      "Немає відповіді від Gemini"
    );
  }

  async codeReview(diff: string) {
    return this.ask(`
Ти Senior Software Engineer.

Зроби review Pull Request.

Перевір:

- баги
- проблеми продуктивності
- безпеку
- TypeScript
- React
- Firebase
- архітектуру

Дай відповідь українською.

PR DIFF:

${diff}
`);
  }

  async tutor(question: string) {
    return this.ask(`
Ти репетитор програмування.

Питання:

${question}
`);
  }

  async dj(question: string) {
    return this.ask(`
Ти DJ AI Assistant.

Допомагай:

- BPM
- Auto Mix
- Playlist
- DJ Sets
- Audio FX

Питання:

${question}
`);
  }

  async autoMix(trackA: string, trackB: string) {
    return this.ask(`
Ти DJ Mix Engineer.

Створи план автоматичного мікшування.

Трек 1:
${trackA}

Трек 2:
${trackB}

Вкажи:

- BPM сумісність
- точки входу
- точки виходу
- EQ
- FX
- Transition
`);
  }
}

export const agent = new AssDJAgent();
